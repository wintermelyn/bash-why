{
  "description": "bash-why: show why each shell command ran",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$PLUGIN_ROOT/codex/bash-why.mjs\" context", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$PLUGIN_ROOT/codex/bash-why.mjs\" context", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "command", "command": "node \"$PLUGIN_ROOT/codex/bash-why.mjs\" pre-tool-use", "timeout": 10 }
        ]
      }
    ]
  }
}
